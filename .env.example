# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth callback registered in InsForge and Google Cloud Console:
# Local: http://localhost:3000/api/auth/callback
# Production: https://<your-production-domain>/api/auth/callback
# Set NEXT_PUBLIC_APP_URL to the matching origin in each environment.

# InsForge Authentication
NEXT_PUBLIC_INSFORGE_URL=https://your-project.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# Neon PostgreSQL (server-only; use the connection string from the Neon console)
# The application and Drizzle refuse non-Neon hosts to prevent writes to InsForge.
NEON_DATABASE_URL=postgresql://<user>:<password>@<project>.neon.tech/<database>?sslmode=require

# Inngest Background Jobs & Cron Scheduler
# Local Dev: Run `npm run inngest:dev` (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

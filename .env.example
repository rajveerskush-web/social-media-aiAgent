# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth callback registered in InsForge and Google Cloud Console:
# Local: http://localhost:3000/api/auth/callback
# Production: https://<your-production-domain>/api/auth/callback
# Set NEXT_PUBLIC_APP_URL to the matching origin in each environment.

# InsForge Authentication
NEXT_PUBLIC_INSFORGE_URL=https://your-project.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# Neon PostgreSQL (server-only; use the connection string from the Neon console)
# The application and Drizzle refuse non-Neon hosts to prevent writes to InsForge.
NEON_DATABASE_URL=postgresql://<user>:<password>@<project>.neon.tech/<database>?sslmode=require

# Inngest Background Jobs & Cron Scheduler
# Local Dev: Run `npm run inngest:dev` (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# Gemini API (server-only; create a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override; defaults to gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash

# Temporary, server-side model test for one specialist's chat only
# GEMINI_TEST_SPECIALIST_ID=seat-mvj4q0fn
# GEMINI_TEST_SPECIALIST_MODEL=gemini-3.5-flash-lite

# E2B Desktop Sandbox (server-only; get an API key at https://e2b.dev)
# Required for running cloud Linux microVM desktops for Research and Content agents
E2B_API_KEY=your_e2b_api_key_here

# ImageKit Asset Hosting (server-only; get credentials from https://imagekit.io)
# Used for permanent hosting of generated images and task media artifacts.
# NOTE: ImageKit is an asset-hosting provider, NOT an image-generation model.
# Never expose IMAGEKIT_PRIVATE_KEY to the client or prefix with NEXT_PUBLIC_.
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Asset Storage Provider for media artifacts: 'local' | 'imagekit' (default: local)
# Use 'local' for development and tests (stores under .data/artifacts).
# Use 'imagekit' in production when permanent cloud asset hosting is configured.
IMAGE_PROVIDER=local
